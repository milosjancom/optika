# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Added automatically on Vercel when Blob storage is connected
BLOB_READ_WRITE_TOKEN=
# Optional password lock for the whole site (username: optika)
SITE_PASSWORD=
